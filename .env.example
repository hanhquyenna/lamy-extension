# Copy this file to .env. These values belong to the person running this clone.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-own-server-only-key
LAMY_LINK_SECRET=generate-a-random-secret-with: openssl rand -hex 32
PORT=8790
# HOST defaults to 127.0.0.1. Use 0.0.0.0 only when you intentionally expose your own server.
HOST=127.0.0.1
